(type == "object")
and (.errors == null)
and (.data | type == "object")
and (.data | has("disablePullRequestAutoMerge"))
and (.data.disablePullRequestAutoMerge | type == "object")
and (.data.disablePullRequestAutoMerge | has("pullRequest"))
and (.data.disablePullRequestAutoMerge.pullRequest | type == "object")
and (.data.disablePullRequestAutoMerge.pullRequest | has("number"))
and (.data.disablePullRequestAutoMerge.pullRequest.number == $pr_number)
and (.data.disablePullRequestAutoMerge.pullRequest | has("autoMergeRequest"))
and (.data.disablePullRequestAutoMerge.pullRequest.autoMergeRequest == null)
