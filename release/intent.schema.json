{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KeishiS/adocweave/blob/main/release/intent.schema.json",
  "title": "AdocWeave release intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "state", "generation"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "state": {
      "enum": ["preparing", "ready"]
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
