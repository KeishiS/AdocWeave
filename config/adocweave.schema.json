{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KeishiS/adocweave/config/adocweave.schema.json",
  "title": "AdocWeave project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema-version"],
  "properties": {
    "schema-version": { "const": 1 },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "syntax-mode": { "enum": ["permissive", "strict"] },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [
              {
                "required": ["value"],
                "not": { "required": ["unset"] },
                "properties": { "value": { "type": "string" } }
              },
              {
                "required": ["unset"],
                "not": { "required": ["value"] },
                "properties": { "unset": { "const": true } }
              }
            ]
          }
        }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max-line-length": { "type": "integer", "minimum": 1 },
        "max-consecutive-blank-lines": { "type": "integer", "minimum": 1 },
        "max-diagnostics": { "type": "integer", "minimum": 1 },
        "rules": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "asciidoc-file-link",
              "attribute-expansion",
              "duplicate-anchor",
              "duplicate-heading-id",
              "excessive-blank-lines",
              "heading-marker-space",
              "inconsistent-list",
              "invalid-anchor",
              "invalid-attribute",
              "invalid-catalog",
              "invalid-cross-reference",
              "invalid-document-structure",
              "invalid-heading-level",
              "invalid-list-presentation",
              "invalid-stem",
              "invalid-table",
              "invalid-url-scheme",
              "line-too-long",
              "macro-boundary",
              "missing-source-language",
              "nesting-limit-exceeded",
              "non-asciidoc-xref",
              "protected-attribute",
              "trailing-whitespace",
              "unclosed-block",
              "unclosed-inline",
              "undefined-attribute",
              "unresolved-cross-reference",
              "unused-attribute"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "severity": {
                "enum": ["error", "warning", "information", "hint"]
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "type": "boolean" },
        "roots": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "max-files": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max-total-bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "max-resource-bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        }
      }
    },
    "local-targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "project-root": { "type": "string", "minLength": 1 }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "newline": { "enum": ["lf", "cr-lf"] },
        "final-newline": { "type": "boolean" },
        "max-consecutive-blank-lines": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "html": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "complete": { "type": "boolean" },
        "stylesheet-files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "stylesheet-urls": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
