{
  "schemaVersion": 1,
  "mutations": [
    {
      "name": "request primitive type",
      "kind": "replace",
      "path": "/request/fields/4/type",
      "value": "boolean",
      "probe": "request"
    },
    {
      "name": "nested field removal",
      "kind": "remove",
      "path": "/settings/RenderPolicy/fields/5",
      "probe": "request"
    },
    {
      "name": "optional field addition",
      "kind": "append",
      "path": "/settings/RenderPolicy/fields",
      "value": { "json": "futureOption", "type": "boolean", "default": false },
      "probe": "request"
    },
    {
      "name": "nested ownership",
      "kind": "replace",
      "path": "/settings/RenderPolicy/fields/5/type",
      "value": "ExternalLinkPolicy",
      "probe": "request"
    },
    {
      "name": "default value",
      "kind": "replace",
      "path": "/settings/RenderPolicy/fields/6/default",
      "value": "complete",
      "probe": "render-default"
    }
  ]
}
